{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "frontendDist": "../frontend"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "./data/vpic.sqlite.xz",
      "./data/requests.json",
      "./data/code-descriptions.sqlite",
      "./data/model-pids.sqlite"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "HiRo Car",
  "mainBinaryName": "obdium",
  "version": "1.5.0",
  "identifier": "com.obdium.app",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HiRo Car",
        "height": 700,
        "width": 1200,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}